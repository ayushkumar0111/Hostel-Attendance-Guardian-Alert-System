# ==============================================================================
# CT GROUP OF INSTITUTIONS - Hostel Attendance & Guardian Alert System
# Shahpur Campus, Jalandhar | Environment Configuration Template
# Built by Ayush Kumar | Developed for CT Group of Institutions
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE INFRASTRUCTURE (Required for Database, Auth & Realtime)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side service key (Used by persistent background worker & webhook daemon)
# WARNING: NEVER expose SUPABASE_SERVICE_ROLE_KEY to client bundles or commit to git!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. CAMPUS GEOFENCE & ATTENDANCE SCHEDULE SETTINGS
# Shahpur Campus, Jalandhar (Verified Google Maps Pin & OSM Boundary)
# ------------------------------------------------------------------------------
VITE_CAMPUS_NAME=CT Group Shahpur Campus, Jalandhar
VITE_CAMPUS_LATITUDE=31.236872
VITE_CAMPUS_LONGITUDE=75.553745
# Radius: Measured campus extent (435m) + 100m buffer = 535m
VITE_GEOFENCE_RADIUS_METERS=535
VITE_MAX_GPS_ACCURACY_METERS=100
VITE_ATTENDANCE_TIMEZONE=Asia/Kolkata
# Scheduled Roll-Call Window: 21:30 - 22:30 IST; Finalization: 22:31 IST
VITE_ATTENDANCE_START_TIME=21:30
VITE_ATTENDANCE_DEADLINE_TIME=22:30

# ------------------------------------------------------------------------------
# 3. TELEPHONY GATEWAY INTEGRATION (Twilio or Exotel Outbound Voice)
# Outbound sequential calling for unrecorded residents at 22:31 IST
# ------------------------------------------------------------------------------
# Provider Selection: 'twilio' | 'exotel' | 'standby'
TELEPHONY_PROVIDER=twilio

# --- Option A: Twilio Voice Gateway Configuration ---
# Obtain from Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Client-safe mirror variables (Optional, if UI status checks are required)
# VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_TWILIO_PHONE_NUMBER=+1234567890

# --- Option B: Exotel Voice Gateway Configuration (Alternative for India) ---
# Obtain from Exotel API Dashboard (https://my.exotel.com)
EXOTEL_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=+91xxxxxxxxxx
EXOTEL_APP_ID=your_exotel_ivr_app_id

# ------------------------------------------------------------------------------
# 4. TELEPHONY WEBHOOK & IVR BRIDGING
# ------------------------------------------------------------------------------
# Public HTTPS URL reachable by Twilio / Exotel to receive DTMF keypresses
# E.g., https://your-server.com or ngrok URL for local development
TELEPHONY_WEBHOOK_BASE_URL=https://your-public-domain-or-ngrok.app
TELEPHONY_PORT=5001

# Warden Emergency Duty Contact (Bridged when Guardian presses 2)
# Falls back to student's assigned hostel warden in Supabase; used if hostel contact is unset
WARDEN_CONTACT_FALLBACK=+91-181-2955999
VITE_WARDEN_CONTACT_FALLBACK=+91-181-2955999

# AI Voice Assistant Webhook / Endpoint (Optional assistant fallback)
AI_VOICE_ASSISTANT_URL=https://your-ai-voice-assistant.service
VITE_AI_VOICE_ASSISTANT_URL=https://your-ai-voice-assistant.service

# ------------------------------------------------------------------------------
# 5. WEB PUSH NOTIFICATIONS (VAPID Keypair)
# ------------------------------------------------------------------------------
# Public VAPID key used by browser service worker for push subscriptions
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# Private VAPID key used ONLY by backend edge functions and daemon (NEVER expose to client)
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:hostel-alert@ctgroup.in

# ------------------------------------------------------------------------------
# 6. INSTITUTION BRANDING & SYSTEM LABELS
# ------------------------------------------------------------------------------
VITE_INSTITUTION_NAME=CT GROUP OF INSTITUTIONS
VITE_COLLEGE_UNIT=CT
VITE_APP_TITLE=CT Hostel Attendance & Guardian Alert System
VITE_AUTHOR_CREDIT=Built by Ayush Kumar
VITE_ORG_CREDIT=Developed by CT
